{
  "name": "mara",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "eas-build-pre-install": "npm install && npm run lingui:compile:ci",
    "eas-build-post-install": "npm run lingui:compile:ci",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:all": "eas build --platform all",
    "build:list": "eas build:list",
    "build:auto": "eas build:configure",
    "lingui:add": "lingui add-locale",
    "lingui:extract": "lingui extract --clean --workers 1",
    "lingui:compile": "lingui compile --typescript",
    "lingui:compile:ci": "lingui compile --strict",
    "lint": "eslint --max-warnings=500 --quiet --ext .js,.jsx,.ts,.tsx,.mjs 'src/**/*' --cache --cache-location './node_modules/.cache/eslint/.eslintcache'",
    "lint:warning": "eslint --max-warnings=500 --ext .js,.jsx,.ts,.tsx,.mjs 'src/**/*' --cache --cache-location './node_modules/.cache/eslint/.eslintcache'",
    "lint:ci": "npm run eslint -- --quiet",
    "icons": "svgr -d src/icons/components src/icons/svg --template src/icons/icon-template.js --typescript --native --no-dimensions",
    "android-debug-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ && cd android && ./gradlew assembleDebug && cd ..",
    "android-release-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/build/intermediates/res/merged/release/ && rm -rf android/app/src/main/res/drawable-* && rm -rf android/app/src/main/res/raw/* && cd android && ./gradlew assembleRelease && cd .."
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lingui/conf": "^5.8.0",
    "@lingui/core": "^5.8.0",
